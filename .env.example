# Copia este archivo a .env y completa con los datos de tu proyecto Supabase
# (Project Settings > API). Nunca subas .env al repositorio.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
# La clave service_role NUNCA debe ir en el frontend (variables VITE_* quedan expuestas al navegador).
